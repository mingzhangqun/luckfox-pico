+#define _GNU_SOURCE
 #include <stddef.h>
 #include <string.h>
 #include <math.h>
 #include <assert.h>
 
 #include "filter_kernels.h"
+
+// Simple implementation of j1 (first-order Bessel function) for uClibc
+#ifndef j1
+static double j1(double x) {
+    // Approximation for small x
+    if (fabs(x) < 1e-8) return x / 2.0;
+    
+    // For larger x, use a simple approximation
+    // This is not as accurate as the full implementation but sufficient for filtering
+    double x2 = x * x;
+    return x / 2.0 * (1.0 - x2 / 8.0 + x2 * x2 / 192.0);
+}
+#endif
 #include "common/common.h"
 
 // NOTE: all filters are designed for discrete convolution
