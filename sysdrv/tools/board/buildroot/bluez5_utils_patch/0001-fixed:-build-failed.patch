--- a/android/compat/wordexp.h
+++ b/android/compat/wordexp.h
@@ -11,7 +11,47 @@
 #ifndef _WORDEXP_H_
 #define _WORDEXP_H_
 
-#define WRDE_NOCMD 0
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+/* POSIX-style flags (subset sufficient for BlueZ usage) */
+#ifndef WRDE_APPEND
+#define WRDE_APPEND   0x01
+#endif
+#ifndef WRDE_DOOFFS
+#define WRDE_DOOFFS   0x02
+#endif
+#ifndef WRDE_NOCMD
+#define WRDE_NOCMD    0x04
+#endif
+#ifndef WRDE_REUSE
+#define WRDE_REUSE    0x08
+#endif
+#ifndef WRDE_SHOWERR
+#define WRDE_SHOWERR  0x10
+#endif
+#ifndef WRDE_UNDEF
+#define WRDE_UNDEF    0x20
+#endif
+
+/* Error return codes */
+#ifndef WRDE_BADCHAR
+#define WRDE_BADCHAR  1
+#endif
+#ifndef WRDE_BADVAL
+#define WRDE_BADVAL   2
+#endif
+#ifndef WRDE_CMDSUB
+#define WRDE_CMDSUB   3
+#endif
+#ifndef WRDE_NOSPACE
+#define WRDE_NOSPACE  4
+#endif
+#ifndef WRDE_SYNTAX
+#define WRDE_SYNTAX   5
+#endif
 
 typedef struct {
 	size_t we_wordc;
@@ -19,13 +59,87 @@ typedef struct {
 	size_t we_offs;
 } wordexp_t;
 
-static inline int wordexp(const char *c, wordexp_t *w, int _i)
+/*
+ * Minimal wordexp/wordfree implementation for environments lacking libc
+ * support. This implementation performs very basic whitespace tokenization
+ * without shell expansions. It is sufficient for BlueZ tools which only
+ * require simple argument splitting and WRDE_APPEND behavior.
+ */
+static inline int wordexp(const char *c, wordexp_t *w, int flags)
 {
-	return -1;
+	if (!w)
+		return WRDE_BADVAL;
+
+	/* Initialize when not appending */
+	if (!(flags & WRDE_APPEND) || !w->we_wordv) {
+		w->we_wordc = 0;
+		w->we_wordv = NULL;
+		/* keep we_offs as provided by caller */
+	}
+
+	if (!c || !*c)
+		return 0;
+
+	/* Count tokens */
+	const char *p = c;
+	size_t addc = 0;
+	int in_token = 0;
+	while (*p) {
+		if (isspace((unsigned char)*p)) {
+			in_token = 0;
+		} else if (!in_token) {
+			addc++;
+			in_token = 1;
+		}
+		p++;
+	}
+
+	size_t basec = w->we_wordc;
+	size_t newc = basec + addc;
+	char **v = (char **)realloc(w->we_wordv, (newc ? newc : 1) * sizeof(char *));
+	if (!v && newc)
+		return WRDE_NOSPACE;
+
+	/* Fill tokens */
+	p = c;
+	size_t idx = basec;
+	while (*p) {
+		/* skip leading spaces */
+		while (*p && isspace((unsigned char)*p))
+			p++;
+		if (!*p)
+			break;
+		const char *start = p;
+		while (*p && !isspace((unsigned char)*p))
+			p++;
+		size_t len = (size_t)(p - start);
+		char *s = (char *)malloc(len + 1);
+		if (!s) {
+			/* roll back newly allocated entries */
+			for (size_t j = basec; j < idx; j++)
+				free(v[j]);
+			return WRDE_NOSPACE;
+		}
+		memcpy(s, start, len);
+		s[len] = '\0';
+		v[idx++] = s;
+	}
+
+	w->we_wordv = v;
+	w->we_wordc = newc;
+	return 0;
 }
 
-static inline void wordfree(wordexp_t *__wordexp)
+static inline void wordfree(wordexp_t *we)
 {
+	if (!we || !we->we_wordv)
+		return;
+	for (size_t i = 0; i < we->we_wordc; i++)
+		free(we->we_wordv[i]);
+	free(we->we_wordv);
+	we->we_wordv = NULL;
+	we->we_wordc = 0;
+	we->we_offs = 0;
 }
 
 #endif
